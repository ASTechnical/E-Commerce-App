<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#1F2C34"
    android:layout_height="match_parent"

    tools:context=".ui.fragments.ProfileFragment">

    <!-- Profile Picture -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profile_img"
        android:layout_width="100dp"
        android:layout_height="80dp"


        android:src="@drawable/profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/profileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/profile_img"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintStart_toStartOf="@+id/profile_img"
        app:layout_constraintTop_toBottomOf="@+id/profile_img" />

    <ImageView
        android:id="@+id/rectanglea"
        android:layout_width="395dp"
        android:layout_height="467dp"

        android:background="@drawable/rectanglebackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileName"
        app:layout_constraintVertical_bias="0.857" />

    <ImageView
        android:id="@+id/unpaidicon"
        android:layout_width="48dp"
        android:layout_height="54dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/unpaid"
        app:layout_constraintStart_toStartOf="@+id/textView11"
        app:layout_constraintTop_toTopOf="@+id/rectanglea" />


    <TextView
        android:id="@+id/unpaidtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="unpaid"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglea"
        app:layout_constraintEnd_toEndOf="@+id/unpaidicon"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/unpaidicon"
        app:layout_constraintTop_toBottomOf="@+id/unpaidicon"
        app:layout_constraintVertical_bias="0.03" />

    <ImageView
        android:id="@+id/processingicon"
        android:layout_width="48dp"
        android:layout_height="54dp"
        android:layout_marginStart="68dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/processing"
        app:layout_constraintStart_toEndOf="@+id/unpaidicon"
        app:layout_constraintTop_toTopOf="@+id/unpaidicon" />


    <TextView
        android:id="@+id/processingtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="processing"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglea"

        app:layout_constraintEnd_toEndOf="@+id/processingicon"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/processingicon"
        app:layout_constraintTop_toBottomOf="@+id/processingicon"
        app:layout_constraintVertical_bias="0.025" />

    <ImageView
        android:id="@+id/oldordericon"
        android:layout_width="48dp"
        android:layout_height="54dp"
        android:src="@drawable/oldorder"
        app:layout_constraintBottom_toBottomOf="@+id/processingicon"
        app:layout_constraintEnd_toEndOf="@+id/rectanglea"
        app:layout_constraintHorizontal_bias="0.562"
        app:layout_constraintStart_toEndOf="@+id/processingicon"
        app:layout_constraintTop_toTopOf="@+id/processingicon"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/oldordertext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:text="oldorder"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglea"

        app:layout_constraintEnd_toEndOf="@+id/rectanglea"
        app:layout_constraintHorizontal_bias="0.329"
        app:layout_constraintStart_toEndOf="@+id/processingtext"
        app:layout_constraintTop_toBottomOf="@+id/oldordericon"
        app:layout_constraintVertical_bias="0.025" />

    <ImageView
        android:id="@+id/cancelicon"
        android:layout_width="49dp"
        android:layout_height="56dp"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="188dp"
        android:src="@drawable/complains"
        app:layout_constraintEnd_toEndOf="@+id/rectanglea"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/complainsicon"
        app:layout_constraintTop_toTopOf="@+id/rectanglea" />

    <TextView
        android:id="@+id/canceltext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="cancel"
        app:layout_constraintEnd_toEndOf="@+id/rectanglea"
        app:layout_constraintHorizontal_bias="0.101"
        app:layout_constraintStart_toStartOf="@+id/rectanglea"
        app:layout_constraintTop_toBottomOf="@+id/complainsicon" />

    <ImageView
        android:id="@+id/complainsicon"
        android:layout_width="48dp"
        android:layout_height="54dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="3dp"
        android:src="@drawable/cancel"
        app:layout_constraintStart_toStartOf="@+id/rectanglea"
        app:layout_constraintTop_toTopOf="@+id/cancelicon" />

    <TextView
        android:id="@+id/complainstext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="complains"
        app:layout_constraintBottom_toBottomOf="@+id/canceltext"
        app:layout_constraintEnd_toEndOf="@+id/rectanglea"
        app:layout_constraintHorizontal_bias="0.272"
        app:layout_constraintStart_toEndOf="@+id/canceltext"
        app:layout_constraintTop_toTopOf="@+id/rectanglea"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/rectanglebottom"
        android:layout_width="401dp"
        android:layout_height="171dp"
        android:background="@drawable/rectanglea"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/supporticon"
        app:layout_constraintTop_toTopOf="@+id/rectanglea"
        app:layout_constraintVertical_bias="0.931" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Services"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglebottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.095"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rectanglebottom"
        app:layout_constraintVertical_bias="0.12" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="My Order"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/rectanglea"
        app:layout_constraintHorizontal_bias="0.066"
        app:layout_constraintStart_toStartOf="@+id/rectanglea"
        app:layout_constraintTop_toTopOf="@+id/rectanglea" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="234dp"
        android:text="@string/view_all"
        android:textColor="@color/aquacolor"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglea"
        app:layout_constraintEnd_toEndOf="@+id/rectanglea"
        app:layout_constraintHorizontal_bias="0.882"
        app:layout_constraintStart_toEndOf="@+id/textView11"
        app:layout_constraintTop_toTopOf="@+id/rectanglea"
        app:layout_constraintVertical_bias="0.038" />

    <ImageView
        android:id="@+id/supporticon"
        android:layout_width="48dp"
        android:layout_height="54dp"
        android:src="@drawable/support"

        app:layout_constraintBottom_toBottomOf="@+id/rectanglebottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.034"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView10"
        app:layout_constraintVertical_bias="0.325" />

    <TextView
        android:id="@+id/supporttext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="support"
        app:layout_constraintEnd_toEndOf="@+id/supporticon"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/supporticon"
        app:layout_constraintTop_toBottomOf="@+id/supporticon" />

    <ImageView
        android:id="@+id/myquestionsicon"
        android:layout_width="48dp"
        android:layout_height="54dp"

        android:layout_marginTop="68dp"
        android:src="@drawable/myquestion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.356"
        app:layout_constraintStart_toEndOf="@+id/supporticon"
        app:layout_constraintTop_toTopOf="@+id/rectanglebottom" />

    <TextView
        android:id="@+id/myquestiotext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="8dp"
        android:text="My Questions"
        app:layout_constraintEnd_toEndOf="@+id/myquestionsicon"
        app:layout_constraintHorizontal_bias="0.513"
        app:layout_constraintStart_toStartOf="@+id/myquestionsicon"
        app:layout_constraintTop_toBottomOf="@+id/myquestionsicon" />

    <ImageView
        android:id="@+id/recentlyicon"
        android:layout_width="48dp"
        android:layout_height="54dp"

        android:layout_marginStart="88dp"
        android:src="@drawable/recently"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglebottom"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toEndOf="@+id/myquestionsicon"
        app:layout_constraintTop_toTopOf="@+id/rectanglebottom"
        />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recently"
        app:layout_constraintBottom_toBottomOf="@+id/rectanglebottom"
        app:layout_constraintEnd_toEndOf="@+id/recentlyicon"
        app:layout_constraintStart_toStartOf="@+id/recentlyicon"
        app:layout_constraintTop_toBottomOf="@+id/recentlyicon"
        app:layout_constraintVertical_bias="0.305" />


</androidx.constraintlayout.widget.ConstraintLayout>










