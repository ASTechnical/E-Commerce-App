<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
   android:padding="@dimen/_10sdp"
    android:layout_marginStart="@dimen/_16sdp"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="359dp"
        android:layout_height="135dp"
        android:elevation="4dp"
        app:cardBackgroundColor="#1F2C34"
        app:cardCornerRadius="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:id="@+id/imageView"
            android:layout_width="143dp"
            android:layout_height="match_parent"

            android:scaleType="centerCrop"
            android:src="@drawable/favouriteimage"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/for_favouritecardView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sdp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/beautiful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beautiful"
                app:layout_constraintBottom_toBottomOf="@+id/for_favouritecardView"
                app:layout_constraintEnd_toEndOf="@+id/for_favouritecardView"
                app:layout_constraintHorizontal_bias="0.497"
                app:layout_constraintStart_toStartOf="@+id/for_favouritecardView"
                app:layout_constraintTop_toTopOf="@+id/for_favouritecardView"
                app:layout_constraintVertical_bias="0.21" />

            <TextView
                android:id="@+id/tShirts_beautiful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="T-Shirts"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/beautiful"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/beautiful"
                app:layout_constraintTop_toBottomOf="@+id/beautiful"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/color_beautiful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="color  Red    size   3x"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/beautiful"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/beautiful"
                app:layout_constraintTop_toBottomOf="@+id/beautiful"
                app:layout_constraintVertical_bias="0.266" />

            <TextView
                android:id="@+id/star_beautifultext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="35$"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/color_beautiful"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/color_beautiful"
                app:layout_constraintTop_toBottomOf="@+id/color_beautiful"
                app:layout_constraintVertical_bias="0.101" />

            <ImageView
                android:id="@+id/star_beautiful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fivestar"
                android:layout_marginStart="@dimen/_45sdp"
                app:layout_constraintBottom_toBottomOf="@+id/star_beautifultext"

                app:layout_constraintStart_toStartOf="@+id/star_beautifultext"

          />

            <ImageView
                android:id="@+id/shape_beautiful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/shape"
                android:layout_marginStart="@dimen/_80sdp"
                app:layout_constraintBottom_toBottomOf="@+id/star_beautiful"
                app:layout_constraintStart_toStartOf="@+id/star_beautiful"


                />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>




</androidx.constraintlayout.widget.ConstraintLayout>


